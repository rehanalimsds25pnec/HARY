//@version=5
indicator("HARY Trading Indicator", shorttitle="HARY", overlay=true)

// Input parameters
lengthMA = input.int(20, "MA Length", minval=1)
lengthRSI = input.int(14, "RSI Length", minval=1)
overbought = input.int(70, "Overbought Level", minval=50, maxval=100)
oversold = input.int(30, "Oversold Level", minval=0, maxval=50)

// Calculate Moving Average
ma = ta.sma(close, lengthMA)

// Calculate RSI
rsi = ta.rsi(close, lengthRSI)

// Plot Moving Average on chart
plot(ma, "Moving Average", color=color.blue, linewidth=2)

// Create RSI indicator panel
hline(overbought, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(50, "Middle", color=color.gray, linestyle=hline.style_dotted)
hline(oversold, "Oversold", color=color.green, linestyle=hline.style_dashed)

// Plot RSI (this will appear in a separate pane)
plot(rsi, "RSI", color=color.purple, linewidth=2, display=display.none)

// Generate trading signals
buySignal = ta.crossover(close, ma) and rsi < 50
sellSignal = ta.crossunder(close, ma) and rsi > 50

// Plot buy/sell signals on chart
plotshape(buySignal, "Buy Signal", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(sellSignal, "Sell Signal", shape.triangledown, location.abovebar, color.red, size=size.small)

// Background color based on RSI levels
bgcolor(rsi > overbought ? color.new(color.red, 90) : rsi < oversold ? color.new(color.green, 90) : na)

// Alert conditions
alertcondition(buySignal, title="Buy Alert", message="HARY: Buy signal detected!")
alertcondition(sellSignal, title="Sell Alert", message="HARY: Sell signal detected!")
alertcondition(rsi > overbought, title="Overbought Alert", message="HARY: RSI is overbought!")
alertcondition(rsi < oversold, title="Oversold Alert", message="HARY: RSI is oversold!")
